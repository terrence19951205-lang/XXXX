{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "shell-hub",
  "mainBinaryName": "x-hub",
  "version": "0.9.7",
  "identifier": "x-hub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "shell-hub",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --js-flags=--scavenger_max_new_space_capacity_mb=8 --disk-cache-size=33554432"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://*.localhost xhub-note: xhub-ext: data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://xhub-sheet.localhost",
        "frame-src": "http://*.localhost xhub-ext:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/shell-hub-32.png",
      "icons/shell-hub-48.png",
      "icons/shell-hub-128.png",
      "icons/shell-hub-256.png",
      "icons/shell-hub-1024.png",
      "icons/shell-hub-icon.icns",
      "icons/shell-hub-icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
